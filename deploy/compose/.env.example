# Docker Compose settings. Create .env from this file with ./init-env.sh or .\init-env.ps1;
# values set to __GENERATE__ are replaced with random secrets. .env is git-ignored.

ELASTIC_VERSION=8.13.4

# Superuser "elastic" (log in to Kibana with it)
ELASTIC_PASSWORD=__GENERATE__
# Built-in user Kibana uses to talk to Elasticsearch
KIBANA_SYSTEM_PASSWORD=__GENERATE__
# User the Logstash pipelines write with (role logstash_writer)
LOGSTASH_INGEST_PASSWORD=__GENERATE__
# User the platform services (platform.yml) connect with (role esm_platform)
ESM_PLATFORM_PASSWORD=__GENERATE__
# Bearer token for the MCP server's HTTP endpoint (http://localhost:8090/mcp)
MCP_TOKEN=__GENERATE__
# Kibana saved-object encryption key, at least 32 characters (required by detection rules)
KIBANA_ENCRYPTION_KEY=__GENERATE__

# Delete logs and metrics after this many days
RETENTION_DAYS=90
# SLM policy that must snapshot an index before it is deleted (register the repository and the
# policy first, see docs/components/elasticsearch.md). Empty: delete without waiting.
SNAPSHOT_POLICY=
# Data stream namespace: logs-<dataset>-<namespace>
ES_NAMESPACE=default

# Time zone of the firewall clocks (IANA name, e.g. Europe/Istanbul). FortiGate and PAN-OS syslog
# timestamps carry no zone; a wrong value shifts events out of the detection rules' time window.
FORTIGATE_TZ=UTC
PANOS_TZ=UTC

# --- Platform layer (platform.yml) ---
# LLM used by llm-orchestrator: mock | ollama | openai-compatible | anthropic | vertex
LLM_PROVIDER=mock
# Required for every provider except mock, e.g. llama3.1:8b (ollama), gpt-4o-mini, claude-haiku-4-5
LLM_MODEL_ID=
# Optional API base URL (defaults: http://ollama:11434, https://api.openai.com/v1, https://api.anthropic.com)
LLM_BASE_URL=
LLM_API_KEY=
# Token budget per window; when exhausted, incidents go to analysts without an LLM call
LLM_MAX_TOKENS_PER_WINDOW=500000
LLM_BUDGET_WINDOW_SECONDS=3600
# Alerts with the same host/user/technique within the window form one incident;
# the incident is emitted early when it reaches the threshold
CORRELATION_THRESHOLD=5
CORRELATION_WINDOW=5m

# --- Outbound integrations (outbound-service); empty = disabled. See docs/integrations/outbound.md ---
# Notifications for new cases at or above this severity; summary = no hosts/users/IPs/free text
NOTIFY_MIN_SEVERITY=high
NOTIFY_DETAIL=summary
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_TO=
SMTP_USER=
SMTP_PASSWORD=
# Tickets: approved (only after an analyst approves) | created | never
TICKET_ON=approved
THEHIVE_URL=
THEHIVE_API_KEY=
JIRA_URL=
JIRA_USER=
JIRA_API_TOKEN=
JIRA_PROJECT=
# Threat intel for external IPs in enrichment-service
ABUSEIPDB_API_KEY=
MISP_URL=
MISP_API_KEY=

# JVM heap sizes
ES_HEAP=1g
LS_HEAP=512m

# Interface Kibana listens on (127.0.0.1 = this machine only, 0.0.0.0 = LAN)
KIBANA_BIND=127.0.0.1
